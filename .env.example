# Canonical origin used by sitemap.xml, robots.txt and Open Graph tags.
# On Vercel this is filled in automatically from VERCEL_PROJECT_PRODUCTION_URL,
# which follows a custom domain once one is attached — so set this only to
# override, e.g. when the canonical domain differs from the Vercel one.
NEXT_PUBLIC_SITE_URL=

# Base URL for the API that serves /api/lead and /api/consult.
# Leave empty to call the same origin (the default in production).
NEXT_PUBLIC_API_BASE=
