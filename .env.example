# Canonical origin used by sitemap.xml, robots.txt and Open Graph tags.
# On Vercel this is filled in automatically from VERCEL_PROJECT_PRODUCTION_URL,
# which follows a custom domain once one is attached — so set this only to
# override, e.g. when the canonical domain differs from the Vercel one.
NEXT_PUBLIC_SITE_URL=

# Base URL for the API that serves /api/lead and /api/consult.
# Leave empty to call the same origin (the default in production).
NEXT_PUBLIC_API_BASE=

# Where the SQLite file lives. On a server this should point at a persistent
# volume, not at a path inside the deployed build.
DATABASE_PATH=data/ira.db

# The "site is being built" curtain. Set PREVIEW_MODE=on to show the holding
# page to visitors; the team gets past it with PREVIEW_PASSWORD. The admin
# panel is never behind this — it has real accounts.
PREVIEW_MODE=
PREVIEW_PASSWORD=
# Any random string. Changing it signs everyone out of the preview.
PREVIEW_SECRET=
